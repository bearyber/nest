{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nest",
  "version": "0.4.4",
  "identifier": "com.intrvl.nest",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Nest",
        "width": 1100,
        "height": 700,
        "minWidth": 900,
        "minHeight": 560,
        "center": true,
        "transparent": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFERjhGNDE2RTYzMjM1NzUKUldSMU5UTG1GdlQ0cmZSTmpEZ3RsbmtDckNQWDY3bFBLdkgyS3JoZ0VPdm5iZlJQR1BUT2h4UEYK",
      "endpoints": ["https://github.com/bearyber/nest-releases/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis", "app", "dmg"],
    "resources": {
      "templates/": "templates/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
